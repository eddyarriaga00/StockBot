{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stockbot",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8777"
      ],
      "port": 8777
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8778",
        "--directory",
        "docs",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8778
    }
  ]
}